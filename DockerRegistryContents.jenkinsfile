@Library('jenkins-sharedlibs')_

/////////////////////////////////////////////////////////////////////////////////////////////////

pipeline {
    environment  {
        HOME = '/home/bobb'
        CURL_PARAMS= "-chainCAfile /certs/SohoBall-Registry-Chain.crt"
    }
    options {
        buildDiscarder(logRotator(numToKeepStr: '20'))
        disableConcurrentBuilds()
        disableResume()
        timestamps()
    }
    stages {
        stage('Generate JSON') {
            agent {
                docker {
                    image 'registry.ubuntu.home/alpine/build_container:main'
                    label 'docker-host'
                    args "--volume '${HOME}:/opt' --volume '${HOME}/src/keys:/keys' --volume '${HOME}/.inf:/inf' --entrypoint='' --dns=10.3.1.4"
                    registryUrl 'https://registry.ubuntu.home/'
                }
            }
            steps {
                ansiColor('xterm') {
                    sh '''
                         (cd bin;git-crypt unlock /keys/work-stuff.key)
                         docker-utilities --credentials '/inf/secret.properties' report --format json --output registryContents.json
                         cp --remove-destination "$(dirname "$(command -v docker-utilities)")/registryReport.groovy" '/home/bobb/registryReport.groovy'
                       '''
                }
                stash includes: 'registryContents.json, storage.txt',  name: 'json'
                archiveArtifacts allowEmptyArchive: true, artifacts: 'registryContents*.json'
            }
        }
        stage('Generate Report') {
            agent {
                docker {
                    image 'registry.ubuntu.home/docker.io/groovy:2.6-jre-alpine'
                    label 'docker-host'
                    args "--volume '${HOME}:/home/groovy/scripts'"
                    registryUrl 'https://registry.ubuntu.home/'
                    reuseNode true
                }
            }
            steps {
                dir ('/home/builder') {
                    sh '''
                        [ ! -e registryContents.json ] || rm registryContents.json
                        find . -name '*.txt' -delete
                       '''
                    unstash 'json'
                    sh 'JSON="registryContents.json" groovy registryReport.groovy'
                    archiveArtifacts allowEmptyArchive: true, artifacts: '**/*.txt'
                }
            }
        }
    }
    post {
        always {
            kafkaBuildReporter()
        }
        cleanup {
            deleteDir()
        }
    }
}
